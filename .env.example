# Copy to .env.local. Never commit secrets.

# Clerk (production sign-in). When CLERK_SECRET_KEY is unset, /sign-in uses local dev bootstrap.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=

# Clerk dashboard: Google OAuth only, public sign-up off.
# Allowed origins: https://watch.hasnain.us https://server.hasnain.us and http://localhost:3847 for dev.
# Sign-in path: /sign-in · After sign-in, /api/auth/clerk-sync sets et_session for /admin.

BOOTSTRAP_OWNER_EMAIL=hasnainmn7@gmail.com
ALLOW_DEV_AUTH=1

# Local SQLite path (default: ./data/app.sqlite). Tests use :memory:.
# There is no Postgres. Do not set DATABASE_URL.
ELTORRENTO_DB=

# libtorrent engine on the ingest VM. Bytes are read from here, not from a demo file.
ENGINE_URL=http://127.0.0.1:8741
ENGINE_TOKEN=
PIECE_WAIT_MS=8000

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_PUBLIC_URL=https://media.hasnain.us

TMDB_API_KEY=

SEERR_URL=http://seerr:5055
SEERR_API_KEY=

STREAM_GATEWAY_URL=http://stream-gateway:8080
MEDIA_ROOT=/data/library
STREAM_CACHE=/data/stream-cache

MGMT_WORKER_URL=
DEPLOY_AGENT_URL=

PROXMOX_CLUSTER_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
